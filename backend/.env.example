# Puerto en el que escucha la API
PORT=4000

# Cadena de conexión a MongoDB.
# - Ejecución local sin Docker: mongodb://localhost:27017/atlas_spaces
# - Ejecución con Docker Compose: mongodb://mongo:27017/atlas_spaces (el host "mongo" es el nombre del servicio)
MONGO_URI=mongodb://localhost:27017/atlas_spaces

# Secreto usado para firmar los access tokens (JWT). Use un valor largo y aleatorio en producción.
JWT_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio

# Duración del access token (formato aceptado por la librería jsonwebtoken). Es de vida corta
# a propósito: la sesión se mantiene mediante el refresh token (ver más abajo), no alargando este valor.
ACCESS_TOKEN_EXPIRES_IN=15m

# Duración en días del refresh token, entregado en una cookie httpOnly y rotado en cada uso.
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# Origin exacto del frontend. Obligatorio y debe ser un valor específico (no "*"), porque el
# refresh token viaja en una cookie y CORS no permite combinar origin "*" con credentials.
FRONTEND_URL=http://localhost:5173

# Nivel de log de la aplicación (pino): fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Entorno de ejecución: development | production | test
NODE_ENV=development
