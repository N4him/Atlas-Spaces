# Puerto en el que escucha la API
PORT=4000

# Cadena de conexión a MongoDB.
# - Ejecución local sin Docker: mongodb://localhost:27017/atlas_spaces
# - Ejecución con Docker Compose: mongodb://mongo:27017/atlas_spaces (el host "mongo" es el nombre del servicio)
MONGO_URI=mongodb://localhost:27017/atlas_spaces

# Secreto usado para firmar los tokens JWT. Use un valor largo y aleatorio en producción.
JWT_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio

# Tiempo de expiración del token (formato aceptado por la librería jsonwebtoken)
JWT_EXPIRES_IN=8h

# Entorno de ejecución: development | production | test
NODE_ENV=development
